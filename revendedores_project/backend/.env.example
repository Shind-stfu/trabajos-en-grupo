# Copiar este archivo como .env y completar localmente. No subir .env a GitHub.
APP_NAME=API Gestion de Revendedores
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000

# Datos de Oracle. Para Autonomous Database, use el connect string del servicio.
# Si su instancia requiere wallet, configure TNS_ADMIN con la ruta local del wallet.
ORACLE_USER=USUARIO_DE_BASE_DE_DATOS
ORACLE_PASSWORD=CAMBIAR_ESTA_CLAVE
ORACLE_DSN=host:1521/servicio
TNS_ADMIN=
WALLET_PASSWORD=

# Genere una clave larga y aleatoria. Nunca reutilice la clave de Oracle.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
